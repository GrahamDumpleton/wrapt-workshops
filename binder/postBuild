#!/bin/bash
# Configure the Binder image so JupyterLab starts in the workshop browser
# with the wrapt workshops listed as installed and ready to open, and
# trusts them without asking, since the visitor is the one who chose the
# link. A launch link naming a workshop still opens that workshop
# directly. The disabled features keep visitors to the supplied
# workshops: no other directories or URLs, no subscribing to collections
# or catalogs, no removing and no editing; Restart puts a workshop back
# as it started. Subscribing to the checkout's own collection indexes
# lists the workshops under each collection's title, numbered in its
# order; a collection added to this repository is added to the list
# here. The welcome message in binder/welcome.md greets the visitor once
# the session starts, with what the workshops are for and how to end it.
#
# The analytics block reports every session's progress events to the
# workshops' own analytics service, so it can be seen where the
# workshops are clear and where they are not. Sessions are anonymous
# and the events never carry file contents, cell output or form
# answers. The token is public by construction, since this file is,
# and only routes events to the service under a label naming Binder;
# the welcome message tells the visitor that progress is reported.
# The second block is JupyterLab's own: it turns off the question about
# fetching Jupyter news, which a fresh container would otherwise put in
# front of every visitor before the welcome message.
set -euo pipefail

# Notebook workshops build an environment of their own on first open,
# installing their requirements and ipykernel with pip. Download every
# workshop's requirements, and ipykernel, into a wheelhouse in the
# image and tell pip to look there first, so the install takes its
# wheels from disk rather than PyPI. It is find-links only, never
# no-index: pip still reaches PyPI for anything the wheelhouse lacks,
# so learners can install packages of their own, and a workshop whose
# requirements are not in the wheelhouse still works, only more slowly.
# The config lives in the image's home directory, so nothing in the
# workshops refers to it and a local checkout is unaffected.
shopt -s nullglob

wheels="${HOME}/.wheels"

mkdir -p "$wheels"

for requirements in workshops/*/requirements.txt; do
    python -m pip download --disable-pip-version-check -d "$wheels" -r "$requirements"
done

python -m pip download --disable-pip-version-check -d "$wheels" ipykernel

mkdir -p "${HOME}/.config/pip"

cat > "${HOME}/.config/pip/pip.conf" <<CONF
[global]
find-links = ${wheels}
CONF

settings="${NB_PYTHON_PREFIX}/share/jupyter/lab/settings"

mkdir -p "$settings"

cat > "$settings/overrides.json" <<'JSON'
{
  "@jupyterlab-workshop/labextension:panel": {
    "defaultWorkshop": "",
    "browseOnStart": true,
    "workshopsDirectory": "workshops",
    "collections": ["collections/decorators/collection.json", "collections/monkey-patching/collection.json"],
    "welcome": "binder/welcome.md",
    "trustPolicy": { "forcedLevel": "trusted" },
    "disabledFeatures": [
      "open-directory",
      "open-url",
      "collections",
      "catalogs",
      "remove",
      "author"
    ],
    "analytics": {
      "sink": "https://workshop-analytics.grumpys.work/events",
      "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJqdGkiOiJhY2NhZDJmYmI2YTY0ODI4OWJiODM2ZjI5OWQ2ODliMSIsInN1YiI6IndyYXB0LWJpbmRlciIsInNjb3BlIjpbImluZ2VzdCJdLCJsYWJlbHMiOnsiZGVwbG95bWVudCI6IndyYXB0LWJpbmRlciJ9LCJvcmlnaW5zIjpbXSwiaWF0IjoxNzkwMTE1MDQ3LCJuYmYiOjE3OTAxMTUwNDcsImV4cCI6MTgyMTEzOTE5OX0.rHy8UfqfSV2Vj0-WTJLGtlbE69pBgGXq-gK2cylkyv4"
